<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <Authors>Álvaro González</Authors>
    <Product>faena</Product>
    <Company>Álvaro González</Company>
    <Description>A local agent that does tasks for you in a web or a Windows program, in the background, asks before anything irreversible and learns what it did.</Description>
    <Copyright>Copyright © 2026 Álvaro González. MIT License.</Copyright>
    <RepositoryUrl>https://github.com/gitsual/faena</RepositoryUrl>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
